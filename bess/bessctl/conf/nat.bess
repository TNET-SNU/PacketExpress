from conf.parser import *
import conf.ports as port
import conf.sim as sim

port.setup_globals()

# ====================================================
#	Read json config file (START HERE)
# ====================================================

interfaces = ["access", "core"]
parser = Parser('conf/default.json')
parser.parse(interfaces)

# ====================================================
#       Core Setup
# ====================================================

# Initialize workers
cores = get_process_affinity()
workers = cores[:parser.workers]
if len(cores) > parser.workers:
    nonworkers = cores[parser.workers:]
else:
    nonworkers = cores
# set_process_affinity_all(nonworkers)
for wid in range(parser.workers):
    bess.add_worker(wid=wid, core=int(workers[wid % len(workers)]))

num_ports = parser.num_ports
worker_per_port = int(parser.workers / num_ports)

# ====================================================
# 	NAT Pipeline (DL + UL)
# ====================================================

nat0::NAT(ext_addrs=[{'ext_addr': '10.1.90.2'}])
nat1::NAT(ext_addrs=[{'ext_addr': '10.1.95.2'}])
nat2::NAT(ext_addrs=[{'ext_addr': '10.2.90.2'}])
nat3::NAT(ext_addrs=[{'ext_addr': '10.2.95.2'}])
nat4::NAT(ext_addrs=[{'ext_addr': '10.3.90.2'}])
nat5::NAT(ext_addrs=[{'ext_addr': '10.3.95.2'}])
nat6::NAT(ext_addrs=[{'ext_addr': '10.4.90.2'}])
nat7::NAT(ext_addrs=[{'ext_addr': '10.4.95.2'}])

# ====================================================
#       Port Setup
# ====================================================

ports = {}
main_port = []
port_idx = 0
for idx, iface in enumerate(interfaces):
    p = port.Port(parser.interfaces[iface]["ifname"], True, None)
    if (p.name in ports):
        continue

    # Core partitioning
    if (worker_per_port > 0):
        p.worker_per_port = worker_per_port
        p.workers = [i + worker_per_port * port_idx for i in range(worker_per_port)]
        port_idx += 1
    else:
        p.workers = [i for i in range(len(workers))]
    
    print("\nport: {}, workers: {}".format(port_idx, p.workers))
    p.init_port(idx, parser.mode)
    p.setup_port(parser.ip_frag_with_eth_mtu, parser.max_ip_defrag_flows, parser.measure_upf)

    check_iperf_port = "tcp dst port 5001 or udp dst port 5001"
    downlink_filter = {"priority": 0, "filter": check_iperf_port, "gate": 1}
    p.bpf.add(filters=[downlink_filter])

    if (idx == 0):
        p.bpf:1 -> 0:nat0 # forward
        p.bpf:0 -> 1:nat1 # reverse
    else:
        p.bpf:1 -> 0:nat1 # forward
        p.bpf:0 -> 1:nat0 # reverse

    # Finally add entry to ports list
    ports[p.name] = p

# connect to pair port
nat0:1 -> ports[parser.core_ifname].rtr # forward
nat1:0 -> ports[parser.core_ifname].rtr # reverse
nat1:1 -> ports[parser.access_ifname].rtr # forward
nat0:0 -> ports[parser.access_ifname].rtr # reverse

# Setup multiple PFs to support multiple NICs
for idx in range(2, parser.num_ports):
    p = port.Port('eth{}'.format(idx + 2), True, None)
    if p.name in ports:
        continue

    # Core partitioning
    if (worker_per_port > 0):
        p.worker_per_port = worker_per_port
        p.workers = [i + worker_per_port * port_idx for i in range(worker_per_port)]
        port_idx += 1
    else:
        p.workers = [i for i in range(len(workers))]

    print("\nport: {}, workers: {}".format(port_idx, p.workers))
    p.init_port(idx, parser.mode)
    p.setup_port(parser.ip_frag_with_eth_mtu, parser.max_ip_defrag_flows, parser.measure_upf)

    check_iperf_port = "tcp dst port 5001 or udp dst port 5001"
    downlink_filter = {"priority": 0, "filter": check_iperf_port, "gate": 1}
    p.bpf.add(filters=[downlink_filter])

    if (idx == 2):
        p.bpf:1 -> 0:nat2:1 -> ports[parser.core_ifname].rtr # forward
        p.bpf:0 -> 1:nat3:0 -> ports[parser.core_ifname].rtr # reverse
    elif (idx == 3):
        p.bpf:1 -> 0:nat3:1 -> ports[parser.access_ifname].rtr # forward
        p.bpf:0 -> 1:nat2:0 -> ports[parser.access_ifname].rtr # reverse
    elif (idx == 4):
        p.bpf:1 -> 0:nat4:1 -> ports[parser.core_ifname].rtr # forward
        p.bpf:0 -> 1:nat5:0 -> ports[parser.core_ifname].rtr # reverse
    elif (idx == 5):
        p.bpf:1 -> 0:nat5:1 -> ports[parser.access_ifname].rtr # forward
        p.bpf:0 -> 1:nat4:0 -> ports[parser.access_ifname].rtr # reverse
    elif (idx == 6):
        p.bpf:1 -> 0:nat6:1 -> ports[parser.core_ifname].rtr # forward
        p.bpf:0 -> 1:nat7:0 -> ports[parser.core_ifname].rtr # reverse
    elif (idx == 7):
        p.bpf:1 -> 0:nat7:1 -> ports[parser.access_ifname].rtr # forward
        p.bpf:0 -> 1:nat6:0 -> ports[parser.access_ifname].rtr # reverse
    
    ports[p.name] = p
