    for (int i = 0; i < recv; i++)
    {
        rx_pkts_copied[i] = rte_pktmbuf_copy(rx_pkts[i], g_mp[port_id][queue_id], 0, UINT32_MAX);
    }
    after_px = px_process(g_pctx[port_id][queue_id], 0, rx_pkts, recv);
    px_parse_batch_for_dpdk_gro(rx_pkts_copied, recv, 1);
    struct rte_gro_param gro_param = {
        .gro_types = RTE_GRO_TCP_IPV4,
        .max_flow_num = (uint16_t)nb_pkts,
        .max_item_per_flow = (uint16_t)nb_pkts,
        .socket_id = 0
    };
    after_dgro = rte_gro_reassemble_burst(rx_pkts_copied, recv, &gro_param);
    px_setup_tso_batch_for_dpdk_gro(rx_pkts_copied, after_dgro);

    /* is there a case where DPDK GRO is better than PX? */
    if (after_px != after_dgro)
    {
        printf("after_px: %d, after_dgro: %d\n", after_px, after_dgro);
        int max = (after_px > after_dgro)?after_px:after_dgro;
        for (int i = 0; i < max; i++)
        {
            struct rte_mbuf *m = rx_pkts[i];
            if (m && (i < after_px))
            {
                printf("[PX] pkt_len: %d ip_len: %d l4_len: %d "
                        "tcp_len: %d tcp_seq: %u tcp_ack: %u tcp_flags: %d \n",
                        m->pkt_len,
                        ntohs(rte_pktmbuf_mtod_offset(m, struct rte_ipv4_hdr *, 14)->total_length),
                        m->l4_len,
                        get_datalen(m),
                        ntohl(*get_seq(m)),
                        ntohl(*get_ack(m)),
                        *get_flags(m));
            }
            m = rx_pkts_copied[i];
            if (m && (i < after_dgro))
            {
                printf("[GRO] pkt_len: %d ip_len: %d l4_len: %d "
                        "tcp_len: %d tcp_seq: %u tcp_ack: %u tcp_flags: %d \n",
                        m->pkt_len,
                        ntohs(rte_pktmbuf_mtod_offset(m, struct rte_ipv4_hdr *, 14)->total_length),
                        m->l4_len,
                        get_datalen(m),
                        ntohl(*get_seq(m)),
                        ntohl(*get_ack(m)),
                        *get_flags(m));
            }
        }
        return -1;
    }
    rte_pktmbuf_free_bulk(rx_pkts_copied, after_dgro);

    return after_px;
}
