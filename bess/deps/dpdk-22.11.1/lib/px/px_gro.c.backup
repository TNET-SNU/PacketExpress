    ipv4->version_ihl = IP_VERSION_IHL;
    ipv4->total_length = htons(1500);
    ipv4->fragment_offset = htons(RTE_IPV4_HDR_DF_FLAG);
    ipv4->src_addr = inet_addr("10.1.90.2");
    ipv4->dst_addr = inet_addr("10.1.95.2");
    ipv4->next_proto_id = IPPROTO_TCP;

    tcph = (struct rte_tcp_hdr *)(ipv4 + 1);
    tcph->src_port = htons(5000);
    tcph->dst_port = htons(6000);
    tcph->data_off = 80;
    tcph->sent_seq = htonl(2920);
    tcph->recv_ack = htonl(1000);
    tcph->tcp_flags = RTE_TCP_ACK_FLAG;
    
    for (int i = 0; i < cnt; i++)
    {
        batch_copied[i] = rte_pktmbuf_copy(batch[i], g_mp[port_id][queue_id], 0, UINT32_MAX);
    }

    /* do PX */
    after_px = px_process(g_pctx[port_id][queue_id], 0, batch, cnt);

    /* do DPDK GRO */
    px_parse_batch_for_dpdk_gro(batch_copied, cnt, 1);
    struct rte_gro_param gro_param = {
        .gro_types = RTE_GRO_TCP_IPV4,
        .max_flow_num = (uint16_t)64,
        .max_item_per_flow = (uint16_t)64,
        .socket_id = 0
    };
    after_dgro = rte_gro_reassemble_burst(batch_copied, cnt, &gro_param);
    px_setup_tso_batch_for_dpdk_gro(batch_copied, after_dgro);

    /* is there a case where DPDK GRO is better than PX? */
    printf("after_px: %d, after_dgro: %d\n", after_px, after_dgro);
    int max = (after_px > after_dgro)?after_px:after_dgro;
    for (int i = 0; i < max; i++)
    {
        struct rte_mbuf *m = batch[i];
        if (m && (i < after_px))
        {
            printf("[PX] pkt_len: %d ip_len: %d l4_len: %d "
                    "tcp_len: %d tcp_seq: %u tcp_ack: %u tcp_flags: %d \n",
                    m->pkt_len,
                    ntohs(rte_pktmbuf_mtod_offset(m, struct rte_ipv4_hdr *, 14)->total_length),
                    m->l4_len,
                    get_datalen(m),
                    ntohl(*get_seq(m)),
                    ntohl(*get_ack(m)),
                    *get_flags(m));
        }

        m = batch_copied[i];
        if (m && (i < after_dgro))
        {
            printf("[GRO] pkt_len: %d ip_len: %d l4_len: %d "
                    "tcp_len: %d tcp_seq: %u tcp_ack: %u tcp_flags: %d \n",
                    m->pkt_len,
                    ntohs(rte_pktmbuf_mtod_offset(m, struct rte_ipv4_hdr *, 14)->total_length),
                    m->l4_len,
                    get_datalen(m),
                    ntohl(*get_seq(m)),
                    ntohl(*get_ack(m)),
                    *get_flags(m));
        }
    }

    rte_pktmbuf_free_bulk(batch_copied, cnt);

    return after_px;
}
/*---------------------------------------------------------------------------*/
uint16_t
px_eth_rx_burst_stall_backup(uint16_t port_id,
                             uint16_t queue_id,
                             struct rte_mbuf **rx_pkts,
                             uint16_t nb_pkts)
{
    struct px_ctx *pctx = g_pctx[port_id][queue_id];
    struct px_ring *ring = &pctx->ring;
    struct rte_mbuf *temp[1024];
    uint16_t cnt, total = 0;
    uint16_t send_len = 0, save_len;
    int full = 0;

    /* stage 1: consume stall-time out packets saved at stage 3 */
    uint16_t send_len = 0;
    if (ring->tail > ring->head)
    {
        send_len = ring->tail - ring->head;
        /* restricted by nb_pkts */
        if (send_len > nb_pkts)
        {
            send_len = nb_pkts;
            full = 1;
        }
        memcpy(rx_pkts,
                ring->queue + ring->head,
                send_len * sizeof(struct rte_mbuf *));
        ring->head += send_len;
    }
    /* tail has turned around */
    else if (ring->tail < ring->head)
    {
        send_len = 1024 + ring->tail - ring->head;
        /* restricted by nb_pkts */
        if (send_len > nb_pkts)
        {
            send_len = nb_pkts;
            full = 1;
        }
        if (send_len <= 1024 - ring->head)
        {
            memcpy(rx_pkts,
                    ring->queue + ring->head,
                    send_len * sizeof(struct rte_mbuf *));
            ring->head += send_len;
        }
        else
        {
            memcpy(rx_pkts,
                    ring->queue + ring->head,
                    (1024 - ring->head) * sizeof(struct rte_mbuf *));
            memcpy(rx_pkts + (1024 - ring->head),
                    ring->queue,
                    (send_len - (1024 - ring->head)) * sizeof(struct rte_mbuf *));
            ring->head = send_len - (1024 - ring->head);
        }
    }
    if (full)
        return nb_pkts;

    /* adjust batch offset */
    rx_pkts += send_len;
    nb_pkts -= send_len;

    /* stage 2: receive if batch is not full */
    px_eth_rx_burst(port_id, queue_id, temp, nb_pkts);

    /* stage 3: if batch is full due to new stall-time out packets, save them */
    if (total > nb_pkts)
    {
        /* copy only allowed amount */
        memcpy(rx_pkts, temp, nb_pkts);

        /* save the others to ring */
        save_len = total - nb_pkts;
        if (ring->tail + save_len <= 1024)
        {
            memcpy(ring->queue + ring->tail, 
                    temp + nb_pkts, 
                    save_len * sizeof(struct rte_mbuf *));

            ring->tail += save_len;
        }
        /* tail will turn around */
        else
        {
            memcpy(ring->queue + ring->tail, 
                    temp + nb_pkts, 
                    (1024 - ring->tail) * sizeof(struct rte_mbuf *));
            memcpy(ring->queue,
                    temp + nb_pkts + (1024 - ring->tail),
                    save_len - (1024 - ring->tail) * sizeof(struct rte_mbut *));
        }

        return nb_pkts;
    }

    /* copy total amount */
    memcpy(rx_pkts, temp, total);

    return total;
}
#endif
/*---------------------------------------------------------------------------*/
uint16_t
px_eth_rx_burst(uint16_t port_id,
                uint16_t queue_id,
                struct rte_mbuf **rx_pkts,
                uint16_t nb_pkts)
{
    struct px_ctx *pctx = g_pctx[port_id][queue_id];
    uint16_t recv, total = 0;

    /* RX and GRO for every latent queues */
    for (int i = 0; i < g_rx_queue_incr; i++)
    {
        /* ToDo: remember the last-read latent queue id for fairness */
        recv = rte_eth_rx_burst(port_id, queue_id * g_rx_queue_incr + i,
                                rx_pkts + total, nb_pkts - total);
        if (!recv)
            continue;
        total += px_process(pctx, i, rx_pkts + total, recv);
    }

    return total;
}
/*---------------------------------------------------------------------------*/
uint16_t
px_eth_rx_burst_stall(uint16_t port_id,
                      uint16_t queue_id,
                      struct rte_mbuf **rx_pkts,
                      uint16_t nb_pkts)
{
    uint16_t read_from_px_ring;
    uint16_t read_from_rx_ring;
    struct rte_ring *ring = g_pctx[port_id][queue_id]->ring;

    /* stage 1: fetch from stall-time out ring */
    read_from_px_ring = rte_ring_dequeue_bulk(ring, (void **)rx_pkts, nb_pkts, NULL);
    if (read_from_px_ring)
        printf("read_from_px_ring: %d\n", read_from_px_ring);

    /* adjust batch offset */
    rx_pkts += read_from_px_ring;
    nb_pkts -= read_from_px_ring;

    /* check batch has more space */
    if (!nb_pkts)
        return read_from_px_ring;

    /* stage 2: receive if batch is not full */
    read_from_rx_ring = px_eth_rx_burst(port_id, queue_id, rx_pkts, nb_pkts);
    if (read_from_rx_ring)
        printf("read_from_rx_ring: %d\n", read_from_rx_ring);

    return read_from_px_ring + read_from_rx_ring;
}
/*---------------------------------------------------------------------------*/
uint16_t
px_eth_rx_burst_stall_backup(uint16_t port_id,
                             uint16_t queue_id,
                             struct rte_mbuf **rx_pkts,
                             uint16_t nb_pkts)
{
    uint16_t recv;
    struct rte_ring *ring = g_pctx[port_id][queue_id]->ring;

    /* stage 2: receive if batch is not full */
    recv = px_eth_rx_burst(port_id, queue_id, rx_pkts, nb_pkts);
    if (recv)
        printf("recv: %d\n", recv);

    /* enqueue to ring */
    for (int i = 0; i < recv; i++)
    {
        if (rte_ring_enqueue(ring, (void *)rx_pkts[i]) < 0)
        {
            printf("enqueue failed");
            continue;
        }
    }

    /* clear */
    memset(rx_pkts, 0, recv * sizeof(struct rte_mbuf *));

    /* dequeue from ring */
    recv = rte_ring_dequeue_bulk(ring, (void **)rx_pkts, recv, NULL);
    if (recv)
        printf("dequeue: %d\n", recv);

    return recv;
}
/*---------------------------------------------------------------------------*/
uint16_t
px_eth_rx_burst_delayed(uint16_t port_id,
                        uint16_t queue_id,
                        struct rte_mbuf **rx_pkts,
                        const uint16_t nb_pkts)
{
    uint16_t cnt = 0, total_sq = 0, total_mq = 0;
    /* RX and GRO for every latent queues */
    for (int i = 0; i < g_rx_queue_incr; i++)
    {
        total_sq = 0;
        while (total_mq + total_sq < nb_pkts)
        {
            if (!rte_eth_rx_queue_count(port_id, queue_id * g_rx_queue_incr + i))
                continue;
            cnt = rte_eth_rx_burst(port_id,
                                   queue_id * g_rx_queue_incr + i,
                                   rx_pkts + total_mq + total_sq,
                                   nb_pkts - total_mq - total_sq);
            if (!cnt)
                break;
            total_sq += cnt;
            /* busy wait for batching */
            // busy_wait_for(100);
        }
        if (!total_sq)
            continue;
        total_mq += px_process(g_pctx[port_id][queue_id], i,
                               rx_pkts + total_mq,
                               total_sq);
    }

    return total_mq;
}
/*---------------------------------------------------------------------------*/
uint16_t
px_eth_tx_burst(uint16_t port_id,
                uint16_t queue_id,
                struct rte_mbuf **tx_pkts,
                const uint16_t nb_pkts)
{
    uint16_t cnt = px_unlink(tx_pkts, nb_pkts, NULL);

    return rte_eth_tx_burst(port_id, queue_id, tx_pkts, cnt);
}
/*---------------------------------------------------------------------------*/
void px_pktmbuf_free(struct rte_mbuf *pkt)
{
    struct rte_mbuf *next;
    uint64_t addr, *temp64;

    /* check mbuf validity */
    if (!pkt)
        return;

    temp64 = (uint64_t *)&pkt->dynfield1[LINK_IDX];
    addr = *temp64;

    /* free the start packet */
    rte_pktmbuf_free(pkt);

    /* if link exists */
    while ((next = (struct rte_mbuf *)addr))
    {
        temp64 = (uint64_t *)&next->dynfield1[LINK_IDX];
        addr = *temp64;

        /* reset link fields to make unlinking idempotent */
        // next->dynfield1[LINK_IDX] = next->dynfield1[LINK_IDX + 1] = 0;
        rte_pktmbuf_free(next);
    }
}
/*---------------------------------------------------------------------------*/
void px_pktmbuf_free_bulk(struct rte_mbuf **pkts, const uint16_t nb_pkts)
{
    uint16_t cnt = px_unlink(pkts, nb_pkts, NULL);

    rte_pktmbuf_free_bulk(pkts, cnt);
}