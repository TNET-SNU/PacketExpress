            .length = SNBUF_DATA,
            .offset = 0,
            .reserved = 0,
        }};
    printf("rx_seg[0].length: %d\n", rx_seg[0].length);
    printf("rx_seg[1].length: %d\n", rx_seg[1].length);
    ret = rte_eth_rx_queue_setup_ex(port_id, rx_queue_id,
                                    nb_rx_desc, socket_id, rx_conf, rx_seg, 2);
}
