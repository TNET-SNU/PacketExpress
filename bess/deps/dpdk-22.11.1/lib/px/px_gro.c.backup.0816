/*---------------------------------------------------------------------------*/
int px_eth_rx_queue_setup(uint16_t port_id, uint16_t rx_queue_id,
                          uint16_t nb_rx_desc, unsigned int socket_id,
                          struct rte_eth_rxconf *rx_conf,
                          struct rte_mempool *mp)
{
    uint16_t num_rxq = g_px_dev[port_id].num_rxq;
    uint16_t num_rxq_incr = g_px_dev[port_id].num_rxq_incr;
    for (int i = 0; i < num_rxq_incr; i++)
    {
        rx_conf->share_group = 0;
        // rx_conf->share_group = port_id * num_rxq + rx_queue_id + 1;
        // rx_conf->share_qid = rx_queue_id * num_rxq_incr + i;
        // rx_conf->share_qid = rx_queue_id * num_rxq_incr;
        if (rte_eth_rx_queue_setup(port_id,
                                   rx_queue_id * num_rxq_incr + i,
                                   nb_rx_desc / num_rxq_incr,
                                   socket_id,
                                   rx_conf,
                                   mp))
            return -1;
    }
    g_nb_rx_desc[port_id][rx_queue_id] = nb_rx_desc;

    return 0;
}
/*---------------------------------------------------------------------------*/
int px_eth_dev_configure(uint16_t port_id, uint16_t num_rxq, uint16_t num_txq,
                         uint16_t num_rxq_incr, unsigned int stall_ns,
                         struct rte_eth_conf *dev_conf)
{
    g_px_dev[port_id].num_rxq = num_rxq;
    g_px_dev[port_id].num_rxq_incr = num_rxq_incr;
    g_px_dev[port_id].num_txq = num_txq;
    g_px_dev[port_id].stall_ns = stall_ns;

    return rte_eth_dev_configure(port_id,
                                 num_rxq * num_rxq_incr,
                                 num_txq,
                                 dev_conf);
}
/*---------------------------------------------------------------------------*/
int px_eth_stats_get(uint16_t port_id, struct rte_eth_stats *stats)
{
    struct rte_eth_stats temp;
    uint16_t num_rxq = g_px_dev[port_id].num_rxq;
    uint16_t num_txq = g_px_dev[port_id].num_txq;
    uint16_t num_rxq_incr = g_px_dev[port_id].num_rxq_incr;
    int qid;
    if (rte_eth_stats_get(port_id, &temp) < 0)
        return -1;

    /* copy the top-half result */
    memcpy(stats, &temp, sizeof(uint64_t) * 8);
    /* get per-queue RX stats */
    for (qid = 0; qid < num_rxq * num_rxq_incr; qid++)
    {
        /* accumulate the stats of latent queues to stat of original queue */
        if (!(qid % num_rxq_incr))
        {
            stats->q_ipackets[qid / num_rxq_incr] =
                temp.q_ipackets[qid];
            stats->q_ibytes[qid / num_rxq_incr] =
                temp.q_ibytes[qid];
            stats->q_errors[qid / num_rxq_incr] =
                temp.q_errors[qid];
        }
        else
        {
            stats->q_ipackets[qid / num_rxq_incr] +=
                temp.q_ipackets[qid];
            stats->q_ibytes[qid / num_rxq_incr] +=
                temp.q_ibytes[qid];
            stats->q_errors[qid / num_rxq_incr] +=
                temp.q_errors[qid];
        }
    }
    /* get per-queue TX stats */
    for (qid = 0; qid < num_txq; qid++)
    {
        stats->q_opackets[qid] = temp.q_opackets[qid];
        stats->q_obytes[qid] = temp.q_obytes[qid];
    }

    return 0;
}
/*---------------------------------------------------------------------------*/
int px_eth_rx_burst_cmp(uint16_t port_id, uint16_t queue_id,
                        struct rte_mbuf **rx_pkts, const uint16_t nb_pkts)
{
    struct rte_mbuf *rx_pkts_copied[64];
    uint16_t recv, after_dgro, after_px;
    /* RX and GRO for every latent queues */
    recv = rte_eth_rx_burst(port_id, queue_id, rx_pkts, nb_pkts);
    for (int i = 0; i < recv; i++)
    {
        rx_pkts_copied[i] = rte_pktmbuf_copy(rx_pkts[i], rx_pkts[i]->pool, 0, UINT32_MAX);
    }
    g_pctx[port_id][queue_id].lq_id = 0;
    after_px = px_process(&g_pctx[port_id][queue_id], rx_pkts, recv);
    px_parse_batch(rx_pkts_copied, recv, 1);
    struct rte_gro_param gro_param = {
        .gro_types = RTE_GRO_TCP_IPV4,
        .max_flow_num = (uint16_t)nb_pkts,
        .max_item_per_flow = (uint16_t)nb_pkts,
        .socket_id = 0};
    after_dgro = rte_gro_reassemble_burst(rx_pkts_copied, recv, &gro_param);
    px_setup_tso_burst(rx_pkts_copied, after_dgro);

    /* is there a case where DPDK GRO is better than PX? */
    if (after_px != after_dgro)
    {
        printf("after_px: %d, after_dgro: %d\n", after_px, after_dgro);
        int max = (after_px > after_dgro) ? after_px : after_dgro;
        for (int i = 0; i < max; i++)
        {
            struct rte_mbuf *m = rx_pkts[i];
            if (m && (i < after_px))
            {
                printf("[PX] pkt_len: %d ip_len: %d l4_len: %d "
                       "tcp_len: %d tcp_seq: %u tcp_ack: %u tcp_flags: %d \n",
                       m->pkt_len,
                       ntohs(rte_pktmbuf_mtod_offset(m, struct rte_ipv4_hdr *, 14)->total_length),
                       m->l4_len,
                       get_data_len(m),
                       ntohl(*get_tcp_seq(m)),
                       ntohl(*get_tcp_ack(m)),
                       *get_tcp_flags(m));
            }
            m = rx_pkts_copied[i];
            if (m && (i < after_dgro))
            {
                printf("[GRO] pkt_len: %d ip_len: %d l4_len: %d "
                       "tcp_len: %d tcp_seq: %u tcp_ack: %u tcp_flags: %d \n",
                       m->pkt_len,
                       ntohs(rte_pktmbuf_mtod_offset(m, struct rte_ipv4_hdr *, 14)->total_length),
                       m->l4_len,
                       get_data_len(m),
                       ntohl(*get_tcp_seq(m)),
                       ntohl(*get_tcp_ack(m)),
                       *get_tcp_flags(m));
            }
        }
        return -1;
    }
    rte_pktmbuf_free_bulk(rx_pkts_copied, after_dgro);

    return after_px;
}
/*---------------------------------------------------------------------------*/
int px_test_CAB(uint16_t port_id, uint16_t queue_id, struct rte_mbuf **batch, uint16_t cnt)
{
    struct rte_mbuf *batch_copied[64];
    struct rte_mbuf *A, *B, *C;
    struct rte_ether_hdr *eth;
    struct rte_ipv4_hdr *ipv4;
    struct rte_tcp_hdr *tcph;
    int after_px = 0, after_dgro = 0;

    A = batch[1];
    A->packet_type = RTE_PTYPE_L3_IPV4 | RTE_PTYPE_L4_TCP;
    A->pkt_len = 1514;
    A->nb_segs = 1;
    A->hash.rss = 0;
    A->l2_len = 14;
    A->l3_len = 20;
    A->l4_len = 20;
    A->next = NULL;

    eth = rte_pktmbuf_mtod(A, struct rte_ether_hdr *);
    assert(eth);
    eth->ether_type = htons(RTE_ETHER_TYPE_IPV4);

    ipv4 = (struct rte_ipv4_hdr *)(eth + 1);
    ipv4->version_ihl = IP_VERSION_IHL;
    ipv4->total_length = htons(1500);
    ipv4->fragment_offset = htons(RTE_IPV4_HDR_DF_FLAG);
    ipv4->src_addr = inet_addr("10.1.90.2");
    ipv4->dst_addr = inet_addr("10.1.95.2");
    ipv4->next_proto_id = IPPROTO_TCP;

    tcph = (struct rte_tcp_hdr *)(ipv4 + 1);
    tcph->src_port = htons(5000);
    tcph->dst_port = htons(6000);
    tcph->data_off = 80;
    tcph->sent_seq = htonl(0);
    tcph->recv_ack = htonl(1000);
    tcph->tcp_flags = RTE_TCP_ACK_FLAG;

    B = batch[2];
    B->packet_type = RTE_PTYPE_L3_IPV4 | RTE_PTYPE_L4_TCP;
    B->pkt_len = 1514;
    B->nb_segs = 1;
    B->hash.rss = 0;
    B->l2_len = 14;
    B->l3_len = 20;
    B->l4_len = 20;
    B->next = NULL;

    eth = rte_pktmbuf_mtod(B, struct rte_ether_hdr *);
    assert(eth);
    eth->ether_type = htons(RTE_ETHER_TYPE_IPV4);

    ipv4 = (struct rte_ipv4_hdr *)(eth + 1);
    ipv4->version_ihl = IP_VERSION_IHL;
    ipv4->total_length = htons(1500);
    ipv4->fragment_offset = htons(RTE_IPV4_HDR_DF_FLAG);
    ipv4->src_addr = inet_addr("10.1.90.2");
    ipv4->dst_addr = inet_addr("10.1.95.2");
    ipv4->next_proto_id = IPPROTO_TCP;

    tcph = (struct rte_tcp_hdr *)(ipv4 + 1);
    tcph->src_port = htons(5000);
    tcph->dst_port = htons(6000);
    tcph->data_off = 80;
    tcph->sent_seq = htonl(1460);
    tcph->recv_ack = htonl(1000);
    tcph->tcp_flags = RTE_TCP_ACK_FLAG;

    C = batch[0];
    C->packet_type = RTE_PTYPE_L3_IPV4 | RTE_PTYPE_L4_TCP;
    C->pkt_len = 1514;
    C->nb_segs = 1;
    C->hash.rss = 0;
    C->l2_len = 14;
    C->l3_len = 20;
    C->l4_len = 20;
    C->next = NULL;

    eth = rte_pktmbuf_mtod(C, struct rte_ether_hdr *);
    assert(eth);
    eth->ether_type = htons(RTE_ETHER_TYPE_IPV4);

    ipv4 = (struct rte_ipv4_hdr *)(eth + 1);
    ipv4->version_ihl = IP_VERSION_IHL;
    ipv4->total_length = htons(1500);
    ipv4->fragment_offset = htons(RTE_IPV4_HDR_DF_FLAG);
    ipv4->src_addr = inet_addr("10.1.90.2");
    ipv4->dst_addr = inet_addr("10.1.95.2");
    ipv4->next_proto_id = IPPROTO_TCP;

    tcph = (struct rte_tcp_hdr *)(ipv4 + 1);
    tcph->src_port = htons(5000);
    tcph->dst_port = htons(6000);
    tcph->data_off = 80;
    tcph->sent_seq = htonl(2920);
    tcph->recv_ack = htonl(1000);
    tcph->tcp_flags = RTE_TCP_ACK_FLAG;

    for (int i = 0; i < cnt; i++)
    {
        batch_copied[i] = rte_pktmbuf_copy(batch[i], batch[i]->pool, 0, UINT32_MAX);
    }

    /* do PX */
    g_pctx[port_id][queue_id].lq_id = 0;
    after_px = px_process(&g_pctx[port_id][queue_id], batch, cnt);

    /* do DPDK GRO */
    px_parse_batch(batch_copied, cnt, 1);
    struct rte_gro_param gro_param = {
        .gro_types = RTE_GRO_TCP_IPV4,
        .max_flow_num = (uint16_t)64,
        .max_item_per_flow = (uint16_t)64,
        .socket_id = 0};
    after_dgro = rte_gro_reassemble_burst(batch_copied, cnt, &gro_param);
    px_setup_tso_burst(batch_copied, after_dgro);

    /* is there a case where DPDK GRO is better than PX? */
    printf("after_px: %d, after_dgro: %d\n", after_px, after_dgro);
    int max = (after_px > after_dgro) ? after_px : after_dgro;
    for (int i = 0; i < max; i++)
    {
        struct rte_mbuf *m = batch[i];
        if (m && (i < after_px))
        {
            printf("[PX] pkt_len: %d ip_len: %d l4_len: %d "
                   "tcp_len: %d tcp_seq: %u tcp_ack: %u tcp_flags: %d \n",
                   m->pkt_len,
                   ntohs(rte_pktmbuf_mtod_offset(m, struct rte_ipv4_hdr *, 14)->total_length),
                   m->l4_len,
                   get_data_len(m),
                   ntohl(*get_tcp_seq(m)),
                   ntohl(*get_tcp_ack(m)),
                   *get_tcp_flags(m));
        }

        m = batch_copied[i];
        if (m && (i < after_dgro))
        {
            printf("[GRO] pkt_len: %d ip_len: %d l4_len: %d "
                   "tcp_len: %d tcp_seq: %u tcp_ack: %u tcp_flags: %d \n",
                   m->pkt_len,
                   ntohs(rte_pktmbuf_mtod_offset(m, struct rte_ipv4_hdr *, 14)->total_length),
                   m->l4_len,
                   get_data_len(m),
                   ntohl(*get_tcp_seq(m)),
                   ntohl(*get_tcp_ack(m)),
                   *get_tcp_flags(m));
        }
    }

    rte_pktmbuf_free_bulk(batch_copied, cnt);

    return after_px;
}
/*---------------------------------------------------------------------------*/
static inline uint16_t
rx_and_px_gro(uint16_t port_id,
              uint16_t queue_id,
              struct rte_mbuf **rx_pkts,
              uint16_t nb_pkts,
              struct timespec *now_ns)
{
    struct px_ctx *pctx = &g_pctx[port_id][queue_id];
    uint16_t recv = 0, total = 0;
    uint16_t rxq_incr = g_px_dev[port_id].num_rxq_incr;
    uint16_t inner_qid;

    pctx->now_ns = *now_ns;

    /* RX and GRO for every latent queues */
    for (int i = 0; i < rxq_incr; i++)
    // for (int i = 0; i < 1; i++)
    {
        /* busy wait for batching */
        // busy_wait_for(10000);

        inner_qid = queue_id * rxq_incr + pctx->lq_id;
        // if (rte_eth_rx_queue_count(port_id, inner_qid) > 0)
        // {
        recv = rte_eth_rx_burst(port_id,
                                inner_qid,
                                rx_pkts + total,
                                nb_pkts - total);
        // }
        if (recv)
        {
            total += px_process(pctx, rx_pkts + total, recv);
        }
        else
        {
            if (g_px_dev[port_id].stall_ns)
            {
                /* update stalls to prevent deadlock */
                update_stall(pctx);
            }
        }
        if (++pctx->lq_id == rxq_incr)
        {
            pctx->lq_id = 0;
        }
        if (total >= nb_pkts)
        {
            return total;
        }
    }

    return total;
}
/*---------------------------------------------------------------------------*/
static inline uint16_t
rx_and_px_gro_delayed(uint16_t port_id,
                      uint16_t queue_id,
                      struct rte_mbuf **rx_pkts,
                      uint16_t nb_pkts)
{
    struct px_ctx *pctx = &g_pctx[port_id][queue_id];
    uint16_t recv = 0, total_sq = 0, total_mq = 0;
    uint16_t rxq_incr = g_px_dev[port_id].num_rxq_incr;
    uint16_t inner_qid;
    /* RX and GRO for every latent queues */
    for (int i = 0; i < rxq_incr; i++)
    {
        total_sq = 0;
        while (total_mq + total_sq < nb_pkts)
        {
            inner_qid = queue_id * rxq_incr + pctx->lq_id;
            // if (rte_eth_rx_queue_count(port_id, inner_qid) > 0)
            // {
            recv = rte_eth_rx_burst(port_id,
                                    inner_qid,
                                    rx_pkts + total_mq + total_sq,
                                    nb_pkts - total_mq - total_sq);
            // }
            if (!recv)
                break;
            total_sq += recv;
            /* busy wait for batching */
            // busy_wait_for(1000);
        }
        if (g_px_dev[port_id].stall_ns && !total_sq)
        {
            /* update stalls to prevent deadlock */
            update_stall(pctx);
        }
        else
        {
            total_mq += px_process(pctx, rx_pkts + total_mq, total_sq);
        }
        if (++pctx->lq_id == rxq_incr)
        {
            pctx->lq_id = 0;
        }
    }

    return total_mq;
}
/*---------------------------------------------------------------------------*/
uint16_t
px_eth_rx_burst(uint16_t port_id,
                uint16_t queue_id,
                struct rte_mbuf **rx_pkts,
                uint16_t nb_pkts)
{
    struct px_ring *ring = g_pctx[port_id][queue_id].ring;
    uint16_t read_from_px_ring = 0;
    uint16_t read_from_rx_ring = 0;
    struct timespec now_ns;

    clock_gettime(CLOCK_MONOTONIC, &now_ns);

    /* stage 1: fetch from stall-time out ring */
    if (g_px_dev[port_id].stall_ns)
    {
        read_from_px_ring = stall_ring_dequeue(ring, rx_pkts, nb_pkts);

        /* adjust batch offset */
        rx_pkts += read_from_px_ring;
        nb_pkts -= read_from_px_ring;

        /* check batch has more space */
        if (!nb_pkts)
        {
            px_measure(rx_pkts, read_from_px_ring, &now_ns, 0);
            return read_from_px_ring;
        }
    }

    /* stage 2: receive if batch is not full */
    read_from_rx_ring = rx_and_px_gro(port_id, queue_id, rx_pkts, nb_pkts, &now_ns);

    // read_from_rx_ring = rx_and_px_gro_delayed(port_id, queue_id, rx_pkts, nb_pkts);

    px_measure(rx_pkts, read_from_px_ring + read_from_rx_ring, &now_ns, 0);
    // px_print_stats(port_id);

    return read_from_px_ring + read_from_rx_ring;
}
/*---------------------------------------------------------------------------*/
uint16_t
px_eth_tx_burst(uint16_t port_id,
                uint16_t queue_id,
                struct rte_mbuf **tx_pkts,
                uint16_t nb_pkts)
{
    struct px_ctx *pctx = &g_pctx[port_id][queue_id];
    struct px_rule *rule = TAILQ_FIRST(&pctx->queue.rq_head);
    struct rte_mbuf *new_batch[512];

    /* if linking is on, do unlink before TX */
    if (rule->dec_act.do_link)
    {
        nb_pkts = px_unlink(tx_pkts, nb_pkts, NULL);
    }
    px_setup_tso_burst(tx_pkts, nb_pkts);

    nb_pkts = px_uso_burst(tx_pkts, nb_pkts, new_batch);

    return rte_eth_tx_burst(port_id, queue_id, new_batch, nb_pkts);

    // return rte_eth_tx_burst(port_id, queue_id, tx_pkts, nb_pkts);
}
/*---------------------------------------------------------------------------*/
void px_pktmbuf_free(struct rte_mbuf *pkt)
{
    struct rte_mbuf *next;
    uint64_t addr, *temp64;

    /* check mbuf validity */
    if (!pkt)
        return;

    temp64 = (uint64_t *)&pkt->dynfield1[LINK_IDX];
    addr = *temp64;

    /* free the start packet */
    rte_pktmbuf_free(pkt);

    /* if link exists */
    while ((next = (struct rte_mbuf *)addr))
    {
        temp64 = (uint64_t *)&next->dynfield1[LINK_IDX];
        addr = *temp64;

        /* reset link fields to make unlinking idempotent */
        // next->dynfield1[LINK_IDX] = next->dynfield1[LINK_IDX + 1] = 0;
        rte_pktmbuf_free(next);
    }
}
/*---------------------------------------------------------------------------*/
void px_pktmbuf_free_bulk(struct rte_mbuf **pkts, uint16_t nb_pkts)
{
    nb_pkts = px_unlink(pkts, nb_pkts, NULL);
    rte_pktmbuf_free_bulk(pkts, nb_pkts);
}