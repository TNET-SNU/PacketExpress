/*
 * Use this code when not use Hash GRO
 * e.g., baseline, only LRO, only DPDK GRO, or LRO + DPDK GRO
 */


#include <rte_ether.h>
#include <rte_ip.h>
#include <rte_tcp.h>
/* for GTP parser */
#include "gtpu_parser.h"
/* for ethernet header  */
#include "utils/ether.h"
/* for ip header  */
#include "utils/ip.h"
/* for udp header */
#include "utils/udp.h"
/* for tcp header */
#include "utils/tcp.h"
/* for gtp header */
#include "utils/gtp.h"
/*----------------------------------------------------------------------------------*/
using bess::utils::Ethernet;
using bess::utils::Gtpv1;
using bess::utils::Ipv4;
using bess::utils::Tcp;
using bess::utils::Udp;

enum { DEFAULT_GATE = 0, FORWARD_GATE = 1};
const unsigned short UDP_PORT_GTPU = 2152;
/*----------------------------------------------------------------------------------*/
void GtpuParser::set_gtp_parsing_attrs(be32_t *sip, be32_t *dip, be16_t *sp,
                                       be16_t *dp, be32_t *teid, be32_t *tipd,
                                       uint8_t *protoid, bess::Packet *p) {
  /* set src_ip */
  set_attr<uint32_t>(this, src_ip_id, p, sip->raw_value());
  /* set dst_ip */
  set_attr<uint32_t>(this, dst_ip_id, p, dip->raw_value());
  /* set src_port_id */
  set_attr<uint16_t>(this, src_port_id, p, sp->raw_value());
  /* set dst_port_id */
  set_attr<uint16_t>(this, dst_port_id, p, dp->raw_value());
  /* set tied_id */
  set_attr<uint32_t>(this, teid_id, p, teid->raw_value());
  /* tunnel_ip4_dst_id  */
  set_attr<uint32_t>(this, tunnel_ip4_dst_id, p, tipd->raw_value());
  /* proto_id */
  set_attr<uint8_t>(this, proto_id, p, *protoid);
}
/*----------------------------------------------------------------------------------*/
enum tcp_option
{
	TCP_OPT_END			= 0,
	TCP_OPT_NOP			= 1,
	TCP_OPT_MSS			= 2,
	TCP_OPT_WSCALE		= 3,
	TCP_OPT_SACK_PERMIT	= 4, 
	TCP_OPT_SACK		= 5,
	TCP_OPT_TIMESTAMP	= 8
};
/*----------------------------------------------------------------------------------*/
static inline void
modify_tcp_mss(uint8_t *tcpopt, int len, uint16_t tcp_mss)
{
    int i;
    int opt, optlen;
    uint16_t *mss;
    
    for (i = 0; i < len; ) {
		opt = *(tcpopt + i++);
		
		if (opt == TCP_OPT_END) {	// end of option field
			break;
		} else if (opt == TCP_OPT_NOP) {	// no option
			continue;
		} else {

			optlen = *(tcpopt + i++);
			if (i + optlen - 2 > len) {
				break;
			}

			if (opt == TCP_OPT_MSS) {
                mss = (uint16_t *)(tcpopt + i);
                *mss = htons(tcp_mss);
                i += 2;
			} else if (opt == TCP_OPT_WSCALE) {
                i++;
			} else if (opt == TCP_OPT_SACK_PERMIT) {
			} else if (opt == TCP_OPT_TIMESTAMP) {
				i += 8;
			} else {
				// not handle
				i += optlen - 2;
			}
		}
	}
}
/*----------------------------------------------------------------------------------*/
static inline int
get_tcp_mss(uint8_t *tcpopt, int len)
{
    int i;
    int opt, optlen;
    uint16_t mss;

    for (i = 0; i < len; ) {
		opt = *(tcpopt + i++);
		
		if (opt == TCP_OPT_END) {	// end of option field
			break;
		} else if (opt == TCP_OPT_NOP) {	// no option
			continue;
		} else {

			optlen = *(tcpopt + i++);
			if (i + optlen - 2 > len) {
				break;
			}

			if (opt == TCP_OPT_MSS) {
                mss = *(uint16_t *)(tcpopt + i);
                i += 2;
			} else if (opt == TCP_OPT_WSCALE) {
                i++;
			} else if (opt == TCP_OPT_SACK_PERMIT) {
			} else if (opt == TCP_OPT_TIMESTAMP) {
				i += 8;
			} else {
				// not handle
				i += optlen - 2;
			}
		}
	}

    return ntohs(mss);
}
/*----------------------------------------------------------------------------------*/
// #define MTU_TRANS 9000
void GtpuParser::ProcessBatch(Context *ctx, bess::PacketBatch *batch) {
  int cnt = batch->cnt();
  Tcp *tcph = NULL;
  Udp *udph = NULL;
  Gtpv1 *gtph = NULL;
  Ipv4 *iph = NULL;
  Ethernet *eth = NULL;
  static const uint32_t _const_val = 0xFFFFFFFFu;
  int l4_len;
  int l3_len; 
  struct rte_mbuf *m;

  for (int i = 0; i < cnt; i++) {
    bess::Packet *p = batch->pkts()[i];
    eth = p->head_data<Ethernet *>();
    if (eth->ether_type != (be16_t)(Ethernet::kIpv4) &&
        eth->ether_type != (be16_t)(Ethernet::kArp)) {
      EmitPacket(ctx, p, DEFAULT_GATE);
      continue;
    }
    // printf("dst_mac: %02x:%02x:%02x:%02x:%02x:%02x\n",
    //   ((uint8_t *)eth)[0], ((uint8_t *)eth)[1], ((uint8_t *)eth)[2],
    //   ((uint8_t *)eth)[3], ((uint8_t *)eth)[4], ((uint8_t *)eth)[5]);

    iph = (Ipv4 *)(eth + 1);
    switch (iph->protocol) {
      case Ipv4::kTcp:
        tcph = (Tcp *)((char *)iph + (iph->header_length << 2));
        set_gtp_parsing_attrs(&iph->src, &iph->dst, &tcph->src_port,
                              &tcph->dst_port, (be32_t *)&_const_val,
                              (be32_t *)&_const_val, &iph->protocol, p);

#ifdef MTU_TRANS
        m = (struct rte_mbuf *)p;
        l3_len = iph->header_length << 2;
#endif
        l4_len = tcph->offset << 2;
        if (tcph->flags & Tcp::kSyn) {
          uint16_t mss;
          mss = get_tcp_mss((uint8_t *)tcph + sizeof(struct rte_tcp_hdr), l4_len - sizeof(struct rte_tcp_hdr));
          uint32_t sip, dip;
          uint16_t sport, dport;
          uint8_t *s, *d;
          sip = iph->src.raw_value();
          dip = iph->dst.raw_value();
          sport = tcph->src_port.raw_value();
          dport = tcph->dst_port.raw_value();
          s = (uint8_t *)&sip;
          d = (uint8_t *)&dip;
          
          fprintf(stderr, "[%s] %02u.%02u.%02u.%02u:%u -> %02u.%02u.%02u.%02u:%u SYN Packet, mss: %u\n",
            __func__, s[0], s[1], s[2], s[3], ntohs(sport),
            d[0], d[1], d[2], d[3], ntohs(dport), mss);
#ifdef MTU_TRANS
          // if (mss <= RTE_ETHER_MTU) {
          //   uint16_t new_mss;
          //   new_mss = MTU_TRANS - 40;
          //   modify_tcp_mss((uint8_t *)tcph + sizeof(struct rte_tcp_hdr), l4_len - sizeof(struct rte_tcp_hdr), new_mss);
          //   fprintf(stderr, "[%s] SYN packet, mss: %u -> %u\n", __func__, mss, new_mss);
          // }
          if (ntohs(sport) == 5001 && mss == MTU_TRANS - 40) {
            uint16_t new_mss;
            new_mss = 1460;
            modify_tcp_mss((uint8_t *)tcph + sizeof(struct rte_tcp_hdr), l4_len - sizeof(struct rte_tcp_hdr), new_mss);
            fprintf(stderr, "[%s] SYN packet, mss: %u -> %u\n", __func__, mss, new_mss);
          }
        }
        if (m->pkt_len > MTU_TRANS + RTE_ETHER_HDR_LEN) {
          m->l2_len = RTE_ETHER_HDR_LEN;
          m->l3_len = l3_len;
          m->l4_len = l4_len;
          m->tso_segsz = MTU_TRANS - (l3_len + l4_len);
          m->ol_flags |= RTE_MBUF_F_TX_IPV4 | 
                        RTE_MBUF_F_TX_IP_CKSUM | 
                        RTE_MBUF_F_TX_TCP_CKSUM | 
                        RTE_MBUF_F_TX_TCP_SEG;
        }
        else {
          m->ol_flags |= RTE_MBUF_F_TX_TCP_CKSUM | RTE_MBUF_F_TX_IP_CKSUM | RTE_MBUF_F_TX_IPV4;
        }
#else // TSO instead of MTU translation
        }
        /* Caveat! Do not use IP length field! */
        // if (iph->length.value() > RTE_ETHER_MTU) {
        if (p->total_len() > RTE_ETHER_MTU + RTE_ETHER_HDR_LEN) {
          m = (struct rte_mbuf *)p;
          l3_len = iph->header_length << 2;
          /* enable TSO */
	        m->l2_len = RTE_ETHER_HDR_LEN;
          m->l3_len = l3_len;
          m->l4_len = l4_len;
	        m->tso_segsz = RTE_ETHER_MTU - (l3_len + l4_len);
          m->ol_flags |= RTE_MBUF_F_TX_IPV4 | 
                        RTE_MBUF_F_TX_IP_CKSUM | 
                        RTE_MBUF_F_TX_TCP_CKSUM | 
                        RTE_MBUF_F_TX_TCP_SEG;
        }
#endif

        EmitPacket(ctx, p, FORWARD_GATE);
        break;
      case Ipv4::kUdp:
        udph = (Udp *)((char *)iph + (iph->header_length << 2));

        if (udph->dst_port == (be16_t)(UDP_PORT_GTPU)) {
          Ipv4 *old_iph = iph;
          gtph = (Gtpv1 *)(udph + 1);
          be32_t teid = (be32_t)gtph->teid.value();

          /* reuse iph, tcph, and udph for innser headers too */
          iph = (Ipv4 *)((char *)gtph + gtph->header_length());
          if (iph->protocol == Ipv4::kTcp) {
            tcph = (Tcp *)((char *)iph + (iph->header_length << 2));
            set_gtp_parsing_attrs(&iph->src, &iph->dst, &tcph->src_port,
                                  &tcph->dst_port, (be32_t *)&teid,
                                  &old_iph->dst, &iph->protocol, p);
          } else if (iph->protocol == Ipv4::kUdp) {
            udph = (Udp *)((char *)iph + (iph->header_length << 2));
            set_gtp_parsing_attrs(&iph->src, &iph->dst, &udph->src_port,
                                  &udph->dst_port, (be32_t *)&teid,
                                  &old_iph->dst, &iph->protocol, p);
          } else {
            set_gtp_parsing_attrs(&iph->src, &iph->dst, (be16_t *)&_const_val,
                                  (be16_t *)&_const_val, (be32_t *)&teid,
                                  &old_iph->dst, &iph->protocol, p);
          }
        }
        else {
          set_gtp_parsing_attrs(&iph->src, &iph->dst, &udph->src_port,
                                &udph->dst_port, (be32_t *)&_const_val,
                                (be32_t *)&_const_val, &iph->protocol, p);
        }
        m = (struct rte_mbuf *)p;
        m->ol_flags |= RTE_MBUF_F_TX_IPV4 | 
                       RTE_MBUF_F_TX_IP_CKSUM | 
                       RTE_MBUF_F_TX_UDP_CKSUM;

        EmitPacket(ctx, p, FORWARD_GATE);
        break;
      case Ipv4::kIcmp:
        set_gtp_parsing_attrs(&iph->src, &iph->dst, (be16_t *)&_const_val,
                              (be16_t *)&_const_val, (be32_t *)&_const_val,
                              (be32_t *)&_const_val, &iph->protocol, p);
      
        EmitPacket(ctx, p, FORWARD_GATE);
        break;
      default:
        /* nothing here at the moment */
        break;
    }

    // EmitPacket(ctx, p, FORWARD_GATE);
  }
}
/*----------------------------------------------------------------------------------*/
CommandResponse GtpuParser::Init(const bess::pb::EmptyArg &) {
  using AccessMode = bess::metadata::Attribute::AccessMode;
  src_ip_id = AddMetadataAttr("src_ip", sizeof(uint32_t), AccessMode::kWrite);
  dst_ip_id = AddMetadataAttr("dst_ip", sizeof(uint32_t), AccessMode::kWrite);
  src_port_id =
      AddMetadataAttr("src_port", sizeof(uint16_t), AccessMode::kWrite);
  dst_port_id =
      AddMetadataAttr("dst_port", sizeof(uint16_t), AccessMode::kWrite);
  teid_id = AddMetadataAttr("teid", sizeof(uint32_t), AccessMode::kWrite);
  tunnel_ip4_dst_id =
      AddMetadataAttr("tunnel_ipv4_dst", sizeof(uint32_t), AccessMode::kWrite);
  proto_id = AddMetadataAttr("ip_proto", sizeof(uint8_t), AccessMode::kWrite);

  return CommandSuccess();
}
/*----------------------------------------------------------------------------------*/
ADD_MODULE(GtpuParser, "gtpu_parser", "parsing module for gtp traffic")
