/*
 * Check if two TCP/IPv4 packets are neighbors.
 */
static inline int CheckSeqOption(struct item *item, struct rte_tcp_hdr *tcph,
                                 uint32_t seq, uint16_t tcp_hl,
                                 uint16_t tcp_dl) {
  struct rte_mbuf *pkt_orig = item->firstseg;

  /* Check if TCP option fields equal */
  if (unlikely(tcp_hl != pkt_orig->l4_len))
    return 0;
  if (memcmp(tcph + 1,
             (struct rte_tcp_hdr *)(rte_pktmbuf_mtod(pkt_orig, char *) +
                                    pkt_orig->l2_len + pkt_orig->l3_len) +
                 1,
             pkt_orig->l4_len - sizeof(struct rte_tcp_hdr)))
    return 0;

  /* append or pre-pend the new packet */
  return (seq == (item->seq + pkt_orig->pkt_len - pkt_orig->l2_len -
                       pkt_orig->l3_len - pkt_orig->l4_len))
             ? 1
             : (((seq + tcp_dl) == item->seq) ? -1 : 0);
}

/*
 * Merge two TCP/IPv4 packets without updating checksums.
 * If cmp is larger than 0, append the new packet to the
 * original packet. Otherwise, pre-pend the new packet to
 * the original packet.
 */
static inline int MergePacket(struct item *item, struct rte_mbuf *pkt, int cmp,
                              uint32_t seq) {
  struct rte_mbuf *pkt_head, *pkt_tail, *lastseg;
  uint16_t hdr_len;

  if (cmp > 0) {
    pkt_head = item->firstseg;
    pkt_tail = pkt;
  } else {
    pkt_head = pkt;
    pkt_tail = item->firstseg;
  }

  /* check if the IPv4 packet length is greater than the max value */
  hdr_len = pkt_head->l2_len + pkt_head->l3_len + pkt_head->l4_len;
  if (unlikely(pkt_head->pkt_len - pkt_head->l2_len + 
               pkt_tail->pkt_len - hdr_len >
               MAX_IPV4_PKT_LENGTH))
    return 0;

  /* remove the packet header for the tail packet */
  rte_pktmbuf_adj(pkt_tail, hdr_len);

  /* chain two packets together */
  if (cmp > 0) {
    item->lastseg->next = pkt;
    item->lastseg = rte_pktmbuf_lastseg(pkt);
  } else {
    lastseg = rte_pktmbuf_lastseg(pkt);
    lastseg->next = item->firstseg;
    item->firstseg = pkt;
    /* update seq to the smaller value */
    item->seq = seq;
  }
  item->nb_merged++;

  /* update MBUF metadata for the merged packet */
  pkt_head->nb_segs += pkt_tail->nb_segs;
  pkt_head->pkt_len += pkt_tail->pkt_len;

  return 1;
}

inline int QueueInc::Assemble(struct rte_mbuf *pkt) {
  struct rte_ether_hdr *eth_hdr;
  struct rte_ipv4_hdr *ipv4_hdr;
  struct rte_tcp_hdr *tcp_hdr;
  struct flow_key *key;
  struct item *cur_item, *prev_item;
  struct flow *cur_flow;
  uint32_t seq, tcp_dl;
  uint16_t hdr_len, flow_idx, prev_item_idx, cur_item_idx;
  int cmp, chain_item = 0; //chain_flow = 0;

  eth_hdr = rte_pktmbuf_mtod(pkt, struct rte_ether_hdr *);
  /* not IP */
  if (unlikely(eth_hdr->ether_type != bswap_16(RTE_ETHER_TYPE_IPV4)))
    return -1;
  pkt->l2_len = sizeof(struct rte_ether_hdr);
  ipv4_hdr = (struct rte_ipv4_hdr *)((char *)eth_hdr + pkt->l2_len);
  /* not TCP */
  if (unlikely(ipv4_hdr->next_proto_id != IPPROTO_TCP))
    return -1;
  pkt->l3_len = (ipv4_hdr->version_ihl & 0x0f) << 2;
  /* if IP option exists */
  if (unlikely(pkt->l3_len > sizeof(struct rte_ipv4_hdr)))
    return -1;
  tcp_hdr = (struct rte_tcp_hdr *)((char *)ipv4_hdr + pkt->l3_len);
  /* only process ACK packet (no FIN, SYN, RST, PSH, URG, ECE or CWR set) */
  if (unlikely(tcp_hdr->tcp_flags != RTE_TCP_ACK_FLAG))
    return -1;
  pkt->l4_len = tcp_hdr->data_off >> 2;
  /* TCP header length out of range */
  if (unlikely((pkt->l4_len < sizeof(struct rte_tcp_hdr)) ||
               (pkt->l4_len > MAX_TCP_HLEN)))
    return -1;
  pkt->pkt_len = bswap_16(ipv4_hdr->total_length) + pkt->l2_len;
  hdr_len = pkt->l2_len + pkt->l3_len + pkt->l4_len;
  tcp_dl = pkt->pkt_len - hdr_len;
  /* only payload length > 0 */
  if (unlikely(tcp_dl <= 0))
    return -1;
  seq = bswap_32(tcp_hdr->sent_seq);
  key = (struct flow_key *)&ipv4_hdr->src_addr;
  flow_idx = rte_hash_crc(key, sizeof(struct flow_key), 0) % burst_;
  cur_flow = &tbl_.flows[flow_idx];
  /* search flow */
  if ((cur_flow->start_item_idx != INVALID_ARRAY_INDEX) &&
      !memcmp(cur_flow->key, key, sizeof(struct flow_key))) {
    /* Check all packets in the flow and try to find a neighbor for the input
     * packet. */
    prev_item_idx = cur_item_idx = cur_flow->start_item_idx;
    do {
      cur_item = &tbl_.items[cur_item_idx];
      cmp = CheckSeqOption(cur_item, tcp_hdr, seq, pkt->l4_len,
                           tcp_dl);
      if (cmp) {
        if (MergePacket(cur_item, pkt, cmp, seq))
          return 1;
        /* Out of 64KB, store the packet into the flow */
        chain_item = 1;
        goto Insert_item;
      }
      prev_item_idx = cur_item_idx;
      cur_item_idx = cur_item->next_pkt_idx;
    } while (cur_item_idx != INVALID_ARRAY_INDEX);
    /* Hole on seq space, store the packet into the flow */
    chain_item = 1;
    goto Insert_item;
  }

  /* search fail */
  if (tbl_.flows[flow_idx].start_item_idx != INVALID_ARRAY_INDEX)
    /* skip rare collision case; ToDo: handle collision */
    return -1;

  /* store index to index array in order to simplify flush */
  tbl_.indices[tbl_.flow_num] = flow_idx;

  /* insert new flow */
  cur_flow->key = key;
  cur_flow->start_item_idx = tbl_.item_num;
  tbl_.flow_num++;

Insert_item:
  /* insert new item with the packet */
  cur_item = &tbl_.items[tbl_.item_num];
  cur_item->firstseg = pkt;
  cur_item->lastseg = rte_pktmbuf_lastseg(pkt);
  cur_item->next_pkt_idx = INVALID_ARRAY_INDEX;
  cur_item->seq = seq;
  cur_item->nb_merged = 1;
  if (chain_item) {
    /* chain them together. */
    prev_item = &tbl_.items[prev_item_idx];
    cur_item->next_pkt_idx = prev_item->next_pkt_idx;
    prev_item->next_pkt_idx = tbl_.item_num;
  }
  tbl_.item_num++;

  return 0;
}

inline uint16_t QueueInc::Flush(struct rte_mbuf **out) {
  struct rte_mbuf *pkt;
  struct rte_ether_hdr *eth;
  struct rte_ipv4_hdr *ipv4;
  uint16_t cnt = 0, flow_idx, item_idx, flow_num = tbl_.flow_num;
  while (tbl_.flow_num > 0) {
    flow_idx = tbl_.indices[flow_num - tbl_.flow_num];
    item_idx = tbl_.flows[flow_idx].start_item_idx;
    while (item_idx != INVALID_ARRAY_INDEX) {
      out[cnt++] = tbl_.items[item_idx].firstseg;
      if (tbl_.items[item_idx].nb_merged > 1) {
        /* update ip header */
        pkt = (tbl_.items[item_idx]).firstseg;
        eth = rte_pktmbuf_mtod(pkt, struct rte_ether_hdr *);
        ipv4 = (struct rte_ipv4_hdr *)(eth + 1);
        ipv4->total_length = bswap_16(pkt->pkt_len - pkt->l2_len);
      }
      /* remove the merged packet from the array */
      tbl_.item_num--;
      /* get the next packet in the flow */
      item_idx = tbl_.items[item_idx].next_pkt_idx;
    }
    /* remove this flow from the array */
    tbl_.flows[flow_idx].start_item_idx = INVALID_ARRAY_INDEX;
    tbl_.flow_num--;
  }

  return cnt;
}

uint16_t QueueInc::PacketSort(struct rte_mbuf **pkts, uint16_t nb_pkts) {
  struct rte_mbuf *unprocess_pkts[nb_pkts];
  int ret;
  uint16_t i, unprocess_num = 0, nb_after_sort = nb_pkts;

  assert(tbl_.bucket_num == 0);
  assert(tbl_.flow_num == 0);
  assert(tbl_.item_num == 0);

  for (i = 0; i < nb_pkts; i++) {
    ret = Assemble(pkts[i]);
    if (ret > 0)
      /* merge successfully */
      nb_after_sort--;
    else if (ret < 0)
      unprocess_pkts[unprocess_num++] = pkts[i];
  }

  if ((nb_after_sort < nb_pkts) || (unprocess_num < nb_pkts)) {
    /* Flush all packets from the tables */
    i = Flush(pkts);
    /* Copy unprocessed packets */
    if (unprocess_num > 0)
      memcpy(&pkts[i], unprocess_pkts,
             sizeof(struct rte_mbuf *) * unprocess_num);
    nb_after_sort = i + unprocess_num;
  }

  return nb_after_sort;
}

const Commands QueueInc::cmds = {{"set_burst", "QueueIncCommandSetBurstArg",
                                  MODULE_CMD_FUNC(&QueueInc::CommandSetBurst),
                                  Command::THREAD_SAFE}};

CommandResponse QueueInc::Init(const bess::pb::QueueIncArg &arg) {
  const char *port_name;
  task_id_t tid;
  CommandResponse err;
  if (!arg.port().length()) {
    return CommandFailure(EINVAL, "Field 'port' must be specified");
  }
  port_name = arg.port().c_str();
  qid_ = arg.qid();

  const auto &it = PortBuilder::all_ports().find(port_name);
  if (it == PortBuilder::all_ports().end()) {
    return CommandFailure(ENODEV, "Port %s not found", port_name);
  }
  port_ = it->second;
  burst_ = bess::PacketBatch::kMaxBurst;

  if (arg.prefetch()) {
    prefetch_ = 1;
  }
  node_constraints_ = port_->GetNodePlacementConstraint();
  tid = RegisterTask((void *)(uintptr_t)qid_);
  if (tid == INVALID_TASK_ID)
    return CommandFailure(ENOMEM, "Context creation failed");

  int ret = port_->AcquireQueues(reinterpret_cast<const module *>(this),
                                 PACKET_DIR_INC, &qid_, 1);
  if (ret < 0) {
    return CommandFailure(-ret);
  }
  tbl_.items = (struct item *)calloc(burst_, sizeof(struct item));
  tbl_.flows = (struct flow *)calloc(burst_, sizeof(struct flow));
  for (int i = 0; i < burst_; i++)
    tbl_.flows[i].start_item_idx = INVALID_ARRAY_INDEX;
  tbl_.buckets = (struct bucket *)calloc(UINT16_MAX + 1, sizeof(struct flow));
  for (int i = 0; i < UINT16_MAX + 1; i++)
    tbl_.buckets[i].start_flow_idx = INVALID_ARRAY_INDEX;
  tbl_.indices = (uint16_t *)calloc(burst_, sizeof(uint16_t));
  tbl_.item_num = 0;
  tbl_.flow_num = 0;
  tbl_.bucket_num = 0;

  return CommandSuccess();
}

void QueueInc::DeInit() {
  if (port_) {
    port_->ReleaseQueues(reinterpret_cast<const module *>(this), PACKET_DIR_INC,
                         &qid_, 1);
  }
  free(tbl_.items);
  free(tbl_.flows);
  free(tbl_.buckets);
  free(tbl_.indices);
}

std::string QueueInc::GetDesc() const {
  return bess::utils::Format("%s:%hhu/%s", port_->name().c_str(), qid_,
                             port_->port_builder()->class_name().c_str());
}

struct task_result QueueInc::RunTask(Context *ctx, bess::PacketBatch *batch,
                                     void *arg) {
  Port *p = port_;

  if (!p->conf().admin_up) {
    return {.block = true, .packets = 0, .bits = 0};
  }

  const queue_t qid = (queue_t)(uintptr_t)arg;

  uint64_t received_bytes = 0;
  uint32_t cnt;

  const int burst = ACCESS_ONCE(burst_);
  const int pkt_overhead = 24;

#ifdef CUMULATIVE_RECV
// #define MINIBATCH RTE_HASH_LOOKUP_BULK_MAX
#define MINIBATCH 64
  batch->clear();
  while (true) {
    uint32_t cnt_ =
        p->RecvPackets(qid, batch->pkts() + batch->cnt(), MINIBATCH);
    batch->incr_cnt(cnt_);
    // if (cnt_ > 0)
    //   printf("temp_cnt: %d\n", cnt_);
    if (cnt_ == 0 || batch->cnt() > burst - MINIBATCH)
      break;
  }
#else
  batch->set_cnt(p->RecvPackets(qid, batch->pkts(), burst));
#endif
  cnt = batch->cnt();
  p->queue_stats[PACKET_DIR_INC][qid].requested_hist[burst]++;
  p->queue_stats[PACKET_DIR_INC][qid].actual_hist[cnt]++;
  p->queue_stats[PACKET_DIR_INC][qid].diff_hist[burst - cnt]++;
  if (cnt == 0) {
    return {.block = true, .packets = 0, .bits = 0};
  }

#ifdef USE_GRO

  /* option 1 */
  /* existing GRO API */
  // struct rte_gro_param gro_param = {.gro_types = RTE_GRO_TCP_IPV4,
  //                                   .max_flow_num = 256,
  //                                   .max_item_per_flow = 256,
  //                                   .socket_id = 0};
  // batch->set_cnt(rte_gro_reassemble_burst(
  //     reinterpret_cast<rte_mbuf **>(batch->pkts()), cnt, &gro_param));

  /* option 2 */
  /* our custom packet sort */
  batch->set_cnt(PacketSort(reinterpret_cast<rte_mbuf **>(batch->pkts()), cnt));
  printf("%u -> %u\n", cnt, batch->cnt());

#endif

  // NOTE: we cannot skip this step since it might be used by scheduler.
  if (prefetch_) {
    for (int i = 0; i < batch->cnt(); i++) {
      received_bytes += batch->pkts()[i]->total_len();
      rte_prefetch0(batch->pkts()[i]->head_data());
    }
  } else {
    for (int i = 0; i < batch->cnt(); i++) {
      received_bytes += batch->pkts()[i]->total_len();
    }
  }
  
  if (!(p->GetFlags() & DRIVER_FLAG_SELF_INC_STATS)) {
    p->queue_stats[PACKET_DIR_INC][qid].packets += cnt;
    p->queue_stats[PACKET_DIR_INC][qid].bytes += received_bytes;
  }

  RunNextModule(ctx, batch);

  return {.block = false,
          .packets = cnt,
          .bits = (received_bytes + cnt * pkt_overhead) * 8};
}

CommandResponse QueueInc::CommandSetBurst(
    const bess::pb::QueueIncCommandSetBurstArg &arg) {
  if (arg.burst() > bess::PacketBatch::kMaxBurst) {
    return CommandFailure(EINVAL, "burst size must be [0,%zu]",
                          bess::PacketBatch::kMaxBurst);
  } else {
    burst_ = arg.burst();
    return CommandSuccess();
  }
}

ADD_MODULE(QueueInc, "queue_inc",
           "receives packets from a port via a specific queue")
