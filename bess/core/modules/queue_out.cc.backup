#include "queue_out.h"

#include "../port.h"
#include "../utils/format.h"
/* for endian functions */
#include <arpa/inet.h>
/* for ethernet header  */
#include "utils/ether.h"
/* for ip header  */
#include "utils/ip.h"
/* for udp header */
#include "utils/udp.h"
/*----------------------------------------------------------------------------------*/
using bess::utils::Ethernet;
using bess::utils::Ipv4;
using bess::utils::Udp;
/*----------------------------------------------------------------------------------*/
uint16_t PacketUnlink(struct rte_mbuf **in, struct rte_mbuf **out, uint16_t nb_pkts) {
  struct rte_mbuf *start, *prev, *cur;
  // uint64_t *temp64;
  // uint16_t *temp16;
  uint16_t cnt = 0;
  int8_t encap_len;
  uint8_t copy_len = sizeof(Ethernet);

  for (int i = 0; i < (int)nb_pkts; i++) {
    start = in[i];
    if (!(cur = (struct rte_mbuf *)((bess::Packet *)start)->get_link())) {
      out[cnt++] = start;
      ((bess::Packet *)start)->clear_link_space();
      continue;
    }

    /* check en/decap space and mirror to linked items */
    // temp16 = (uint16_t *)&start->dynfield1[8];
    // printf("dynfield1[8].lo: %d, data_off: %d\n", *temp16, start->data_off);
    // encap_len = *temp16 - start->data_off;
    // *temp16 = 0;
    
    encap_len = ((bess::Packet *)start)->get_o_data_off() - start->data_off;
    printf("o_data_off: %d, data_off: %d, encap_len: %d\n", ((bess::Packet *)start)->get_o_data_off(), start->data_off, encap_len);
    encap_len = 0;
    copy_len += (encap_len > 0) ? encap_len : 0;

    /* rollback to original pkt len */
    // temp16 = (uint16_t *)&start->dynfield1[8] + 1;
    // printf("dynfield1[8].hi: %d, start->pkt_len: %d\n", *temp16, start->pkt_len);
    // start->pkt_len = *temp16;
    // *temp16 = 0;
    printf("o_pkt_len: %d, pkt_len: %d\n", ((bess::Packet *)start)->get_o_pkt_len(), start->pkt_len);
    start->pkt_len = ((bess::Packet *)start)->get_o_pkt_len();

    /* rollback to original nb segs */
    // printf("dynfield1[6]: %d, start->nb_segs: %d\n", *temp16, start->nb_segs);
    // start->nb_segs = start->dynfield1[6];
    printf("o_nb_segs: %d, nb_segs: %d\n", ((bess::Packet *)start)->get_o_nb_segs(), start->nb_segs);
    start->nb_segs = ((bess::Packet *)start)->get_o_nb_segs();

    /* flush start item to output batch */
    out[cnt++] = start;

    // temp64 = (uint64_t *)&start->dynfield1[4];
    // cur = (struct rte_mbuf *)*temp64;
    // *temp64 = 0;
    // cur = (struct rte_mbuf *)((bess::Packet *)start)->get_link();
    printf("cur: %p\n", cur);
    ((bess::Packet *)start)->clear_link_space();
    while (cur) {
      /*
       * Now, copy modified header from first item
       * which is processed by UPF to linked latent items
       */
      /* adjust header space of cur item as same as start item */
      cur->data_off -= encap_len;
      cur->data_len += encap_len;
      cur->pkt_len += encap_len;

      /* check insanity */
      if (!((uint8_t *)cur->buf_addr + cur->data_off)) {
        /* failed to adjust header space for en/decaped packet */
        printf("failed to adjust\n");
        /* free mbuf */
        rte_pktmbuf_free(cur);
        continue;
      }

      printf("o_data_off: %d, data_off: %d\n", ((bess::Packet *)cur)->get_o_data_off(), cur->data_off);
      
      printf("o_pkt_len: %d, pkt_len: %d\n", ((bess::Packet *)cur)->get_o_pkt_len(), cur->pkt_len);
      
      printf("o_nb_segs: %d, nb_segs: %d\n", ((bess::Packet *)cur)->get_o_nb_segs(), cur->nb_segs);

      /* copy from Ethernet header to encaped header */
      memcpy((uint8_t *)cur->buf_addr + cur->data_off,
             (uint8_t *)start->buf_addr + start->data_off, copy_len);

      /* flush cur item to output batch */
      out[cnt++] = cur;

      // temp64 = (uint64_t *)&cur->dynfield1[4];
      // cur = (struct rte_mbuf *)*temp64;
      // *temp64 = 0;
      prev = cur;
      cur = (struct rte_mbuf *)((bess::Packet *)prev)->get_link();
      ((bess::Packet *)prev)->clear_link_space();
    }
  }

  return cnt;
}

CommandResponse QueueOut::Init(const bess::pb::QueueOutArg &arg) {
  const char *port_name;
  int ret;

  if (!arg.port().length()) {
    return CommandFailure(EINVAL, "Field 'port' must be specified");
  }

  port_name = arg.port().c_str();
  qid_ = arg.qid();

  const auto &it = PortBuilder::all_ports().find(port_name);
  if (it == PortBuilder::all_ports().end()) {
    return CommandFailure(ENODEV, "Port %s not found", port_name);
  }
  port_ = it->second;

  node_constraints_ = port_->GetNodePlacementConstraint();

  ret = port_->AcquireQueues(reinterpret_cast<const module *>(this),
                             PACKET_DIR_OUT, &qid_, 1);
  if (ret < 0) {
    return CommandFailure(-ret);
  }

  return CommandSuccess();
}

void QueueOut::DeInit() {
  if (port_) {
    port_->ReleaseQueues(reinterpret_cast<const module *>(this), PACKET_DIR_OUT,
                         &qid_, 1);
  }
}

std::string QueueOut::GetDesc() const {
  return bess::utils::Format("%s:%hhu/%s", port_->name().c_str(), qid_,
                             port_->port_builder()->class_name().c_str());
}

#ifdef USE_LINK
void QueueOut::ProcessBatch(Context *, bess::PacketBatch *batch) {
  Port *p = port_;
  uint16_t cnt;

  const queue_t qid = qid_;

  uint64_t sent_bytes = 0;
  int sent_pkts = 0;

  bess::Packet *out[bess::PacketBatch::kMaxBurst];
  if (p->conf().admin_up) {
    cnt = batch->cnt();
    batch->set_cnt(PacketUnlink(
      reinterpret_cast<rte_mbuf **>(batch->pkts()),
      reinterpret_cast<rte_mbuf **>(out), cnt));
    // printf("Unlink: %d -> %d\n", cnt, batch->cnt());
    sent_pkts = p->SendPackets(qid, out, batch->cnt());
  }

  if (!(p->GetFlags() & DRIVER_FLAG_SELF_OUT_STATS)) {
    const packet_dir_t dir = PACKET_DIR_OUT;
    for (int i = 0; i < sent_pkts; i++)
      sent_bytes += out[i]->total_len();
    p->queue_stats[dir][qid].packets += sent_pkts;
    p->queue_stats[dir][qid].dropped += (batch->cnt() - sent_pkts);
    p->queue_stats[dir][qid].bytes += sent_bytes;
  }

  if (sent_pkts < batch->cnt())
    bess::Packet::Free(out + sent_pkts, batch->cnt() - sent_pkts);
}
#else
void QueueOut::ProcessBatch(Context *, bess::PacketBatch *batch) {
  Port *p = port_;
  uint16_t cnt;

  const queue_t qid = qid_;

  uint64_t sent_bytes = 0;
  int sent_pkts = 0;

  if (p->conf().admin_up) {
    cnt = batch->cnt();
    sent_pkts = p->SendPackets(qid, batch->pkts(), cnt);
  }

  if (!(p->GetFlags() & DRIVER_FLAG_SELF_OUT_STATS)) {
    const packet_dir_t dir = PACKET_DIR_OUT;

    for (int i = 0; i < sent_pkts; i++)
      sent_bytes += batch->pkts()[i]->total_len();
    p->queue_stats[dir][qid].packets += sent_pkts;
    p->queue_stats[dir][qid].dropped += (batch->cnt() - sent_pkts);
    p->queue_stats[dir][qid].bytes += sent_bytes;
  }

  if (sent_pkts < batch->cnt())
    bess::Packet::Free(batch->pkts() + sent_pkts, batch->cnt() - sent_pkts);
}
#endif

ADD_MODULE(QueueOut, "queue_out",
           "sends packets to a port via a specific queue")
