#include "queue_out.h"

#include "../port.h"
#include "../utils/format.h"
/* for endian functions */
#include <arpa/inet.h>
/* for ethernet header  */
#include "utils/ether.h"
/* for ip header  */
#include "utils/ip.h"
/* for udp header */
#include "utils/udp.h"
/*----------------------------------------------------------------------------------*/
using bess::utils::Ethernet;
using bess::utils::Ipv4;
using bess::utils::Udp;
/*----------------------------------------------------------------------------------*/
uint16_t QueueOut::PacketUnlink(bess::Packet **in, bess::Packet **out, uint16_t nb_pkts) {
  bess::Packet *next, *first, *cur;
  uint16_t cnt = 0;
  int8_t encap_len;
  uint8_t copy_len = sizeof(Ethernet);

  for (int i = 0; i < (int)nb_pkts; i++) {
    first = cur = in[i];
    out[cnt++] = cur;
    while ((next = cur->get_link())) {
      /* clear linkspace */
      cur->clear_link_space();
      cur = next;

      /*
       * Now, copy modified header from first item
       * which is processed by UPF to linked latent items
       */

      /* check en/decap space and mirror to linked items */
      encap_len = first->get_encap_len();
      if (encap_len > 0) {
        /* pre-allocate space for encaped header(s) */
        cur->prepend(encap_len);
        copy_len += encap_len;
      }
      else if (encap_len < 0) {
        /* remove space for decaped header(s) */
        cur->adj(-encap_len);
      }

      /* check insanity */
      if (!cur->head_data()) {
        /* failed to prepend or adj header space for encaped packet */
        bess::Packet::Free(cur);
        continue;
      }
      
      /* copy from Ethernet header to encaped header(s) */
      memcpy(cur->head_data(), first->head_data(), copy_len);
      out[cnt++] = cur;
    }
  }

  return cnt;
}

CommandResponse QueueOut::Init(const bess::pb::QueueOutArg &arg) {
  const char *port_name;
  int ret;

  if (!arg.port().length()) {
    return CommandFailure(EINVAL, "Field 'port' must be specified");
  }

  port_name = arg.port().c_str();
  qid_ = arg.qid();

  const auto &it = PortBuilder::all_ports().find(port_name);
  if (it == PortBuilder::all_ports().end()) {
    return CommandFailure(ENODEV, "Port %s not found", port_name);
  }
  port_ = it->second;

  node_constraints_ = port_->GetNodePlacementConstraint();

  ret = port_->AcquireQueues(reinterpret_cast<const module *>(this),
                             PACKET_DIR_OUT, &qid_, 1);
  if (ret < 0) {
    return CommandFailure(-ret);
  }

  return CommandSuccess();
}

void QueueOut::DeInit() {
  if (port_) {
    port_->ReleaseQueues(reinterpret_cast<const module *>(this), PACKET_DIR_OUT,
                         &qid_, 1);
  }
}

std::string QueueOut::GetDesc() const {
  return bess::utils::Format("%s:%hhu/%s", port_->name().c_str(), qid_,
                             port_->port_builder()->class_name().c_str());
}

void QueueOut::ProcessBatch(Context *, bess::PacketBatch *batch) {
  Port *p = port_;
  uint16_t cnt;

  const queue_t qid = qid_;

  uint64_t sent_bytes = 0;
  int sent_pkts = 0;
#ifdef USE_LINK
  bess::Packet *out[bess::PacketBatch::kMaxBurst];
#endif

  if (p->conf().admin_up) {
    cnt = batch->cnt();
#ifdef USE_LINK
    batch->set_cnt(PacketUnlink(batch->pkts(), out, cnt));
    // printf("Unlink: %d -> %d\n", cnt, batch->cnt());
    sent_pkts = p->SendPackets(qid, out, batch->cnt());
#else
    sent_pkts = p->SendPackets(qid, batch->pkts(), cnt);
#endif
  }

  if (!(p->GetFlags() & DRIVER_FLAG_SELF_OUT_STATS)) {
    const packet_dir_t dir = PACKET_DIR_OUT;

    for (int i = 0; i < sent_pkts; i++) {
#ifdef USE_LINK
      sent_bytes += out[i]->total_len();
#else
      sent_bytes += batch->pkts()[i]->total_len();
#endif
    }

    p->queue_stats[dir][qid].packets += sent_pkts;
    p->queue_stats[dir][qid].dropped += (batch->cnt() - sent_pkts);
    p->queue_stats[dir][qid].bytes += sent_bytes;
  }

  if (sent_pkts < batch->cnt()) {
#ifdef USE_LINK
    bess::Packet::Free(out + sent_pkts, batch->cnt() - sent_pkts);
#else
    bess::Packet::Free(batch->pkts() + sent_pkts, batch->cnt() - sent_pkts);
#endif
  }
}

ADD_MODULE(QueueOut, "queue_out",
           "sends packets to a port via a specific queue")
