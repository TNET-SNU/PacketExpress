				qerIDList: []uint32{n6, 1},
				// needDecap: 1,
				needDecap: 0,
			}

			pdrN6DL1 := pdr{
				srcIface:     core,
				srcIfaceMask: 0xFF,
				// tunnelIP4Dst: ip2int(u.accessIP),
				// tunnelIP4DstMask: 0xFFFFFFFF,
				// tunnelTEID: n3TEID + i,
				// tunnelTEIDMask: 0xFFFFFFFF,
				appFilter: applicationFilter{
					srcIP:     ip2int(aupfip2) + (i & 0xFFFF0000),
					srcIPMask: 0xFFFFFFFF,
					dstIP:     ip2int(ueip2) + (i & 0xFFFF0000),
					dstIPMask: 0xFFFFFFFF,
					srcPortRange: portRange{
						low:  uint16(i & 0xFFFF),
						high: uint16(i & 0xFFFF),
					},
					// dstPortRange: portRange{
					// 	low:  (ueport + j) & 0xFFFF,
					// 	high: (ueport + j) & 0xFFFF,
					// },
				},

				precedence: 246,

				pdrID:     0,
				fseID:     uint64(n3TEID + i),
				ctrID:     8*i + 2,
				farID:     n3,
				qerIDList: []uint32{n6, 1},
				needDecap: 0,
				// needDecap: 1,
			}

			// create/delete uplink pdr
			pdrN6UL1 := pdr{
				srcIface:     access,
				srcIfaceMask: 0xFF,
				// tunnelIP4Dst: ip2int(u.accessIP),
				// tunnelIP4DstMask: 0xFFFFFFFF,
				// tunnelTEID: n3TEID + i,
				// tunnelTEIDMask: 0xFFFFFFFF,
				appFilter: applicationFilter{
					srcIP:     ip2int(ueip2) + (i & 0xFFFF0000),
					srcIPMask: 0xFFFFFFFF,
					dstIP:     ip2int(aupfip2) + (i & 0xFFFF0000),
					dstIPMask: 0xFFFFFFFF,
					srcPortRange: portRange{
						low:  uint16(i & 0xFFFF),
						high: uint16(i & 0xFFFF),
					},
					// dstPortRange: portRange{
					// 	low:  (ueport + j) & 0xFFFF,
					// 	high: (ueport + j) & 0xFFFF,
					// },
				},

				precedence: 246,

				pdrID:     1,
				fseID:     uint64(n3TEID + i),
				ctrID:     8*i + 3,
				farID:     n6,
				qerIDList: []uint32{n6, 1},
				// needDecap: 1,
				needDecap: 0,
			}

			pdrN6DL2 := pdr{
				srcIface:     core,
				srcIfaceMask: 0xFF,
				// tunnelIP4Dst: ip2int(u.accessIP),
				// tunnelIP4DstMask: 0xFFFFFFFF,
				// tunnelTEID: n3TEID + i,
				// tunnelTEIDMask: 0xFFFFFFFF,
				appFilter: applicationFilter{
					srcIP:     ip2int(aupfip3) + (i & 0xFFFF0000),
					srcIPMask: 0xFFFFFFFF,
					dstIP:     ip2int(ueip3) + (i & 0xFFFF0000),
					dstIPMask: 0xFFFFFFFF,
					srcPortRange: portRange{
						low:  uint16(i & 0xFFFF),
						high: uint16(i & 0xFFFF),
					},
					// dstPortRange: portRange{
					// 	low:  (ueport + j) & 0xFFFF,
					// 	high: (ueport + j) & 0xFFFF,
					// },
				},

				precedence: 246,

				pdrID:     0,
				fseID:     uint64(n3TEID + i),
				ctrID:     8*i + 4,
				farID:     n3,
				qerIDList: []uint32{n6, 1},
				needDecap: 0,
				// needDecap: 1,
			}

			// create/delete uplink pdr
			pdrN6UL2 := pdr{
				srcIface:     access,
				srcIfaceMask: 0xFF,
				// tunnelIP4Dst: ip2int(u.accessIP),
				// tunnelIP4DstMask: 0xFFFFFFFF,
				// tunnelTEID: n3TEID + i,
				// tunnelTEIDMask: 0xFFFFFFFF,
				appFilter: applicationFilter{
					srcIP:     ip2int(ueip3) + (i & 0xFFFF0000),
					srcIPMask: 0xFFFFFFFF,
					dstIP:     ip2int(aupfip3) + (i & 0xFFFF0000),
					dstIPMask: 0xFFFFFFFF,
					srcPortRange: portRange{
						low:  uint16(i & 0xFFFF),
						high: uint16(i & 0xFFFF),
					},
					// dstPortRange: portRange{
					// 	low:  (ueport + j) & 0xFFFF,
					// 	high: (ueport + j) & 0xFFFF,
					// },
				},

				precedence: 246,

				pdrID:     1,
				fseID:     uint64(n3TEID + i),
				ctrID:     8*i + 5,
				farID:     n6,
				qerIDList: []uint32{n6, 1},
				// needDecap: 1,
				needDecap: 0,
			}

			pdrN6DL3 := pdr{
				srcIface:     core,
				srcIfaceMask: 0xFF,
				// tunnelIP4Dst: ip2int(u.accessIP),
				// tunnelIP4DstMask: 0xFFFFFFFF,
				// tunnelTEID: n3TEID + i,
				// tunnelTEIDMask: 0xFFFFFFFF,
				appFilter: applicationFilter{
					srcIP:     ip2int(aupfip4) + (i & 0xFFFF0000),
					srcIPMask: 0xFFFFFFFF,
					dstIP:     ip2int(ueip4) + (i & 0xFFFF0000),
					dstIPMask: 0xFFFFFFFF,
					srcPortRange: portRange{
						low:  uint16(i & 0xFFFF),
						high: uint16(i & 0xFFFF),
					},
					// dstPortRange: portRange{
					// 	low:  (ueport + j) & 0xFFFF,
					// 	high: (ueport + j) & 0xFFFF,
					// },
				},

				precedence: 246,

				pdrID:     0,
				fseID:     uint64(n3TEID + i),
				ctrID:     8*i + 6,
				farID:     n3,
				qerIDList: []uint32{n6, 1},
				needDecap: 0,
				// needDecap: 1,
			}

			// create/delete uplink pdr
			pdrN6UL3 := pdr{
				srcIface:     access,
				srcIfaceMask: 0xFF,
				// tunnelIP4Dst: ip2int(u.accessIP),
				// tunnelIP4DstMask: 0xFFFFFFFF,
				// tunnelTEID: n3TEID + i,
				// tunnelTEIDMask: 0xFFFFFFFF,
				appFilter: applicationFilter{
					srcIP:     ip2int(ueip4) + (i & 0xFFFF0000),
					srcIPMask: 0xFFFFFFFF,
					dstIP:     ip2int(aupfip4) + (i & 0xFFFF0000),
					dstIPMask: 0xFFFFFFFF,
					srcPortRange: portRange{
						low:  uint16(i & 0xFFFF),
						high: uint16(i & 0xFFFF),
					},
					// dstPortRange: portRange{
					// 	low:  (ueport + j) & 0xFFFF,
					// 	high: (ueport + j) & 0xFFFF,
					// },
				},

				precedence: 246,

				pdrID:     1,
				fseID:     uint64(n3TEID + i),
				ctrID:     8*i + 7,
				farID:     n6,
				qerIDList: []uint32{n6, 1},
				// needDecap: 1,
				needDecap: 0,
			}

			// pdrs := []pdr{pdrN9Down, pdrN9Up}
			// pdrs := []pdr{pdrN9Down_dpi, pdrN9Down, pdrN9Up_dpi, pdrN9Up}
			// pdrs := []pdr{pdrN6Down, pdrN6Up, pdrN6Down_, pdrN6Up_}
			pdrs := []pdr{
				// below are used to maximise number of tuples
				pdrTuple0, pdrTuple1, pdrTuple2, pdrTuple3,
				pdrTuple4, pdrTuple5, pdrTuple6, pdrTuple7,
				pdrTuple8, pdrTuple9, // pdrTuple10, pdrTuple11,
				// pdrTuple12, pdrTuple13, pdrTuple14, pdrTuple15,
				// below are used to make real rule
				pdrN6DL0, pdrN6UL0, pdrN6DL1, pdrN6UL1,
				pdrN6DL2, pdrN6UL2, pdrN6DL3, pdrN6UL3,
			}
			// pdrs := []pdr{
			// 	pdrN6UL0,
			// }

			// create/delete downlink far
			farDown := far{
				farID: n3,
				fseID: uint64(n3TEID + i),

				applyAction: ActionForward,
				dstIntf:     ie.DstInterfaceAccess,
				// tunnelType:   0x0, // Access
				// tunnelIP4Src: ip2int(u.accessIP),
				// tunnelIP4Dst: ip2int(enbip) + enbIdx,
				// tunnelTEID:   n3TEID + i,
				// tunnelPort:   tunnelGTPUPort,
			}

			// create/delete uplink far
			farN6Up := far{
				farID: n6,
				fseID: uint64(n3TEID + i),

				applyAction: ActionForward,
				dstIntf:     ie.DstInterfaceCore,
			}

			// farN9Up := far{
			// 	farID: n9,
			// 	fseID: uint64(n3TEID + i),

			// 	applyAction:  ActionForward,
			// 	dstIntf:      ie.DstInterfaceCore,
			// 	tunnelType:   0x1, // Core
			// 	tunnelIP4Src: ip2int(u.coreIP),
			// 	tunnelIP4Dst: ip2int(aupfip) + aupfIdx,
			// 	tunnelTEID:   n9TEID + i,
			// 	tunnelPort:   tunnelGTPUPort,
			// }

			// fars := []far{farDown, farN6Up, farN9Up}
			// fars := []far{farDown, farN9Up}
			fars := []far{farDown, farN6Up}

			// create/delete uplink qer
			qerN6 := qer{
				qerID:    n6,
				fseID:    uint64(n3TEID + i),
				qosLevel: ApplicationQos,
				qfi:      9,
				ulGbr:    20000000000,
				ulMbr:    20000000000,
				dlGbr:    20000000000,
				dlMbr:    20000000000,
			}

			// qerN9 := qer{
			// 	qerID: n9,
			// 	fseID: uint64(n3TEID + i),
			// 	qosLevel: ApplicationQos,
			// 	qfi:   8,
			// 	ulGbr: 5000000,
			// 	ulMbr: 6000000,
			// 	dlGbr: 7000000,
			// 	dlMbr: 9000000,
			// }

			// qers := []qer{qerN6, qerN9}
			// qers := []qer{qerN9}
			qers := []qer{qerN6}

			// create/delete session qers
			sessionQer := qer{
				qerID:    1,
				fseID:    uint64(n3TEID + i),
				qosLevel: SessionQos,
				qfi:      0,
				ulGbr:    20000000000,
				ulMbr:    20000000000,
				dlGbr:    20000000000,
				dlMbr:    20000000000,
			}

			qers = append(qers, sessionQer)
			var allRules PacketForwardingRules
			// if i == uint32(0) {
			// 	allRules = PacketForwardingRules{
			// 		pdrs: pdrsTuple,
			// 		fars: fars,
			// 		qers: qers,
			// 	}

			// } else {
			// 	allRules = PacketForwardingRules{
			// 		pdrs: pdrs,
			// 		fars: fars,
			// 		qers: qers,
			// 	}
			// }
			allRules = PacketForwardingRules{
				pdrs: pdrs,
				fars: fars,
				qers: qers,
			}

			if mode.create() {
				u.sendMsgToUPF(upfMsgTypeAdd, allRules, PacketForwardingRules{})
			} else if mode.modify() {
				u.sendMsgToUPF(upfMsgTypeMod, allRules, allRules)
			} else if mode.delete() {
				u.sendMsgToUPF(upfMsgTypeDel, allRules, PacketForwardingRules{})
			} else {
				log.Fatalln("Unsupported method", mode)
			}
		}
		// u.sendMsgToUPF(upfMsgTypeResume, PacketForwardingRules{}, PacketForwardingRules{})
	}

	log.Infoln("Sessions/s:", float64(s.MaxSessions)/time.Since(start).Seconds())
}
