			// 	srcIface:     access,
			// 	srcIfaceMask: 0xFF,
			// 	// tunnelIP4Dst: ip2int(u.accessIP),
			// 	// tunnelIP4DstMask: 0xFFFFFFFF,
			// 	// tunnelTEID: n3TEID + i,
			// 	// tunnelTEIDMask: 0xFFFFFFFF,
			// 	appFilter: applicationFilter{
			// 		srcIP:     ip2int(ueip2) + (i >> 16),
			// 		srcIPMask: 0xFFFFFFFF,
			// 		dstIP:     ip2int(aupfip2) + (i >> 16),
			// 		dstIPMask: 0xFFFFFFFF,
			// 		srcPortRange: portRange{
			// 			low:  uint16(i & 65535),
			// 			high: uint16(i & 65535),
			// 		},
			// 		// dstPortRange: portRange{
			// 		// 	low:  (ueport + j) & 65535,
			// 		// 	high: (ueport + j) & 65535,
			// 		// },
			// 	},

			// 	precedence: 235,

			// 	pdrID:     1,
			// 	fseID:     uint64(n3TEID + i),
			// 	ctrID:     1,
			// 	farID:     n6,
			// 	qerIDList: []uint32{n6, 1},
			// 	// needDecap: 1,
			// 	needDecap: 0,
			// }

			// pdrs := []pdr{pdrN9Down, pdrN9Up}
			// pdrs := []pdr{pdrN9Down_dpi, pdrN9Down, pdrN9Up_dpi, pdrN9Up}
			// pdrs := []pdr{pdrN6Down, pdrN6Up, pdrN6Down_, pdrN6Up_}
			pdrs := []pdr{pdrN6DL_0, pdrN6UL_0,
				pdrN6DL_1, pdrN6UL_1,
				pdrN6DL_2, pdrN6UL_2,
				pdrN6DL_3, pdrN6UL_3,
				pdrN6DL_4, pdrN6UL_4,
				pdrN6DL_5, pdrN6UL_5,
				pdrN6DL_6, pdrN6UL_6,
				pdrN6DL_7, pdrN6UL_7,
				// pdrN6DL_8, pdrN6UL_8,
			}

			// create/delete downlink far
			farDown := far{
				farID: n3,
				fseID: uint64(n3TEID + i),

				applyAction: ActionForward,
				dstIntf:     ie.DstInterfaceAccess,
				// tunnelType:   0x0, // Access
				// tunnelIP4Src: ip2int(u.accessIP),
				// tunnelIP4Dst: ip2int(enbip) + enbIdx,
				// tunnelTEID:   n3TEID + i,
				// tunnelPort:   tunnelGTPUPort,
			}

			// create/delete uplink far
			farN6Up := far{
				farID: n6,
				fseID: uint64(n3TEID + i),

				applyAction: ActionForward,
				dstIntf:     ie.DstInterfaceCore,
			}

			// farN9Up := far{
			// 	farID: n9,
			// 	fseID: uint64(n3TEID + i),

			// 	applyAction:  ActionForward,
			// 	dstIntf:      ie.DstInterfaceCore,
			// 	tunnelType:   0x1, // Core
			// 	tunnelIP4Src: ip2int(u.coreIP),
			// 	tunnelIP4Dst: ip2int(aupfip) + aupfIdx,
			// 	tunnelTEID:   n9TEID + i,
			// 	tunnelPort:   tunnelGTPUPort,
			// }

			// fars := []far{farDown, farN6Up, farN9Up}
			// fars := []far{farDown, farN9Up}
			fars := []far{farDown, farN6Up}

			// create/delete uplink qer
			qerN6 := qer{
				qerID: n6,
				fseID: uint64(n3TEID + i),
				qfi:   9,
				ulGbr: 200000000,
				ulMbr: 200000000,
				dlGbr: 200000000,
				dlMbr: 200000000,
			}

			// qerN9 := qer{
			// 	qerID: n9,
			// 	fseID: uint64(n3TEID + i),
			// 	qfi:   8,
			// 	ulGbr: 5000000,
			// 	ulMbr: 6000000,
			// 	dlGbr: 7000000,
			// 	dlMbr: 9000000,
			// }

			// qers := []qer{qerN6, qerN9}
			// qers := []qer{qerN9}
			qers := []qer{qerN6}

			// create/delete session qers
			sessionQer := qer{
				qerID:    1,
				fseID:    uint64(n3TEID + i),
				qosLevel: SessionQos,
				qfi:      0,
				ulGbr:    200000000,
				ulMbr:    200000000,
				dlGbr:    200000000,
				dlMbr:    200000000,
			}

			qers = append(qers, sessionQer)

			allRules := PacketForwardingRules{
				pdrs: pdrs,
				fars: fars,
				qers: qers,
			}

			if mode.create() {
				u.sendMsgToUPF(upfMsgTypeAdd, allRules, PacketForwardingRules{})
			} else if mode.modify() {
				u.sendMsgToUPF(upfMsgTypeMod, allRules, allRules)
			} else if mode.delete() {
				u.sendMsgToUPF(upfMsgTypeDel, allRules, PacketForwardingRules{})
			} else {
				log.Fatalln("Unsupported method", mode)
			}
		}
	}
   log.Infoln("Sessions/s:", float64(s.MaxSessions)/time.Since(start).Seconds())
}
